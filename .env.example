# session-hub 环境变量示例
#
# 用法：按需复制为仓库根目录的 .env（.gitignore 已忽略 .env / .env.*，
# 仅保留 .env.example），或直接用 shell 环境变量覆盖。
# 千万不要把真实 token 提交进仓库。

# ---------------------------------------------------------------------------
# HUB_HOST：dev server 监听地址
# ---------------------------------------------------------------------------
# 默认 127.0.0.1 —— 只有本机能连。这是本服务最重要的一道防线：
# 数据目录里是全量 AI 会话（可能含私钥、公司代码），默认不对局域网开放。
#
# 仅当确实需要局域网/双栈访问时才改成：
#   HUB_HOST=::         macOS 双栈（同时接受 ::1 与 127.0.0.1 连接）
#   HUB_HOST=0.0.0.0    仅 IPv4 通配
# 并且必须同时设置下面的 HUB_TOKEN，否则所有非本机 /api 请求一律 401。
#
# 注意：生产启动读的是 Nitro 的 HOST / PORT（不是 HUB_HOST），见 package.json 的
# start 脚本；生产同样应显式 HOST=127.0.0.1。
HUB_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# HUB_TOKEN：非本机访问凭证
# ---------------------------------------------------------------------------
# 留空 = 未配置 → 只允许本机（127.0.0.1 / ::1）访问，非本机请求返回 401。
# 生成方式（32 字节随机）：
#   openssl rand -hex 32
#
# 三种携带方式（任一即可）：
#   1) Authorization: Bearer <token>
#   2) x-hub-token: <token>
#   3) Cookie hub_token=<token>   （浏览器首次用 ?token=<token> 换票后自动下发，
#                                  或 POST /api/auth/token {"token":"<token>"} 换票）
# 换到的 Cookie 为 HttpOnly + SameSite=Lax，有效期 30 天。
HUB_TOKEN=

# ---------------------------------------------------------------------------
# HUB_HOME：数据目录
# ---------------------------------------------------------------------------
# 默认 ~/.session-hub（SQLite / Grafeo / 插件配置 / hub-token 文件都在这里）。
# 必须写绝对路径，不支持 ~ 展开；测试与演示请指向临时目录做隔离。
# HUB_HOME=/Users/you/.session-hub

# ---------------------------------------------------------------------------
# HUB_TRUST_PROXY：是否信任 x-forwarded-for（可选，默认关闭）
# ---------------------------------------------------------------------------
# 默认 0。仅当服务部署在「可信反向代理」后面、且拿不到真实对端 TCP 地址时才设为 1。
# 该请求头可被客户端伪造（实测伪造 127.0.0.1 能抵达），非代理部署开启等于自毁鉴权。
# HUB_TRUST_PROXY=0
